{
  "appId": "com.questcompendium.app",
  "productName": "Quest Compendium",
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "icon": "public/icon.png",
  "mac": {},
  "linux": {
    "target": ["AppImage"],
    "icon": "public/icon.png",
    "category": "Game"
  },
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Quest Compendium"
  },
  "appx": {
    "identityName": "Turius.QuestCompendium",
    "publisher": "CN=A57BCB5A-9BA6-45BA-ADC2-BE500AFCA82C",
    "publisherDisplayName": "Turius",
    "applicationId": "QuestCompendium",
    "displayName": "Quest Compendium",
    "backgroundColor": "#0d0e15"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ]
}
